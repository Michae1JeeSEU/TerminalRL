{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ft-rs-selective:record:v1",
  "title": "Selective reoptimization record envelope",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "source_binding",
    "snapshot_id",
    "snapshot_time",
    "effective_time",
    "scope",
    "measurements",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "rs_select_record_v1"
    },
    "record_type": {
      "enum": [
        "Selection",
        "LocalSearch",
        "Label",
        "Training",
        "Delivery",
        "Outcome"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "source_binding": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string"
    },
    "ancestry_root_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "development",
        null
      ]
    },
    "snapshot_time": {
      "type": "number"
    },
    "effective_time": {
      "type": "number"
    },
    "scope": {
      "type": "object",
      "required": [
        "eligible_ids",
        "selected_ids",
        "background_ids",
        "mandatory_ids",
        "nominal_k",
        "actual_k",
        "objective_frame_id"
      ],
      "properties": {
        "eligible_ids": {
          "$ref": "#/$defs/ids"
        },
        "selected_ids": {
          "$ref": "#/$defs/ids"
        },
        "background_ids": {
          "$ref": "#/$defs/ids"
        },
        "mandatory_ids": {
          "$ref": "#/$defs/ids"
        },
        "nominal_k": {
          "type": "integer",
          "minimum": 0
        },
        "actual_k": {
          "type": "integer",
          "minimum": 0
        },
        "objective_frame_id": {
          "type": "string"
        },
        "overflow": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "measurements": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string"
    },
    "objective": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "unknown_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true,
  "$comment": "Set inclusion/disjointness, timing inequalities, source equality and budget accounting require semantic validator; JSON Schema alone is not a safety proof."
}
